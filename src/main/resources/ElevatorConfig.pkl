@ModuleInfo { minPklVersion = "0.27.0" }
module frc.robot.pkl.ElevatorConfig

import "FRC.pkl"

motors: Listing<FRC.MotorController>

constraints: Constraints

feedforward: ElevatorFeedforwardConstants

setpoints: ElevatorSetpoints

class ElevatorFeedforwardConstants {
  kS: Number
  kG: Number
  kV: Number
  kA: Number
}

class Constraints {
  maxVelocity: Number(isPositive)
  maxAcceleration: Number(isPositive)
}

class ElevatorSetpoints {
  humanPlayer: Number
  L1: Number
  L2: Number
  L3: Number
  L4: Number
}
